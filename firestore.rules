rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "seob1984@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // Public signage needs read-only access to the current menu and menu library.
    // All writes to these collections remain restricted to the administrator.
    match /todayMenu/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /menus/{menuId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Meal records, company data, rosters, audit logs, access tickets,
    // counters and all other collections are administrator-only.
    // Kiosk operations use validated callable Cloud Functions (Admin SDK).
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
